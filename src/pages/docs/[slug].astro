---
import Redirect from '../../layouts/Redirect.astro';
import { docSlugs } from '../../lib/catalog';

export function getStaticPaths() {
  return docSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<Redirect to={`https://github.com/bendyline/gilde/blob/main/docs/${slug}.md`} />
