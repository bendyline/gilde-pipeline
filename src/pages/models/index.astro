---
import Layout from '../../layouts/Layout.astro';
import {
  chatModels,
  imageModels,
  videoModels,
  modelQuantization,
  modelEngines,
  formatGB,
  formatContext,
} from '../../lib/catalog';

const chat = chatModels();
const images = imageModels();
const videos = videoModels();

const licenseBadge = (cls: unknown): string => {
  const c = String(cls ?? '').toLowerCase();
  if (c === 'open' || c === 'permissive') return 'badge-open';
  if (c === 'proprietary' || c === 'closed' || c === 'non-commercial') return 'badge-closed';
  if (c) return 'badge-mid';
  return 'badge-plain';
};
---

<Layout title="Models - gilde" description="Local chat, image, and video model manifests: verified downloads, quantizations, context windows, licenses, and tuned defaults.">
  <h1>Models</h1>
  <p class="lede">
    Manifests for models a gezel crew can run locally: verified file hashes, per-engine download
    blocks (llama.cpp, MLX, Ollama), honest size and context numbers, license classes, and tuned
    sampling defaults. Sorted by how strongly the catalog recommends them.
  </p>

  <h2 id="chat-models">Chat models</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Params</th>
          <th>Quant</th>
          <th class="num">Context</th>
          <th>License</th>
          <th class="num">Size</th>
          <th>Engines</th>
          <th class="num">Reco</th>
        </tr>
      </thead>
      <tbody>
        {chat.map((m) => (
          <tr>
            <td><a href={`/models/${m.id}/`}>{m.name}</a></td>
            <td>{m.parameterSize ?? ''}</td>
            <td>{modelQuantization(m)}</td>
            <td class="num">{formatContext(m.contextWindow)}</td>
            <td>
              <span class={`badge ${licenseBadge(m.licenseClass)}`}>{m.licenseShortName ?? m.license ?? ''}</span>
            </td>
            <td class="num">{formatGB(m.approxSizeBytes)}</td>
            <td>{modelEngines(m).join(', ')}</td>
            <td class="num">{typeof m.recoScore === 'number' ? m.recoScore : ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="image-models">Image models</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Category</th>
          <th>Quant</th>
          <th>License</th>
          <th class="num">Size</th>
          <th>Hardware</th>
        </tr>
      </thead>
      <tbody>
        {images.map((m) => (
          <tr>
            <td>
              {m.upstream ? <a href={m.upstream}>{m.name}</a> : m.name}
            </td>
            <td>{m.category ?? ''}</td>
            <td>{m.quantization ?? ''}</td>
            <td>
              <span class={`badge ${licenseBadge(m.licenseClass)}`}>{m.licenseShortName ?? m.license ?? ''}</span>
            </td>
            <td class="num">{formatGB(m.approxSizeBytes)}</td>
            <td>{m.hardwareTier ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="video-models">Video models</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Family</th>
          <th class="num">Frames</th>
          <th>License</th>
          <th class="num">Size</th>
          <th>Hardware</th>
        </tr>
      </thead>
      <tbody>
        {videos.map((m) => (
          <tr>
            <td>
              {m.upstream ? <a href={m.upstream}>{m.name}</a> : m.name}
            </td>
            <td>{m.family ?? ''}</td>
            <td class="num">{m.defaultNumFrames ?? ''}</td>
            <td>
              <span class={`badge ${licenseBadge(m.licenseClass)}`}>{m.licenseShortName ?? m.license ?? ''}</span>
            </td>
            <td class="num">{formatGB(m.approxSizeBytes)}</td>
            <td>{m.hardwareTier ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Layout>
