---
import Redirect from '../../layouts/Redirect.astro';
import { GEZEL_DOCS, itemIds } from '../../lib/catalog';

export function getStaticPaths() {
  return itemIds('project-types').map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
---

<Redirect to={`${GEZEL_DOCS}project-type/${id}/`} />
