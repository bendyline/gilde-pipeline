---
import Layout from '../../layouts/Layout.astro';
import { communityCategories, kindCount } from '../../lib/catalog';

const total = kindCount('community/toolsets');
const categories = communityCategories();
---

<Layout title="Community MCP servers - gilde" description="A searchable directory of community MCP servers indexed by the gilde catalog.">
  <h1>Community MCP servers</h1>
  <p class="lede">
    {total.toLocaleString('en-US')} MCP servers auto-imported from the community registry, so a
    gezel crew can discover capabilities far beyond the first-party toolsets. These are
    third-party projects: review a server before you wire it into a crew.
  </p>

  <form class="filter-bar" id="community-filter" action="" method="get">
    <input
      type="search"
      id="community-q"
      name="q"
      placeholder="Filter by name or description"
      autocomplete="off"
      aria-label="Filter community servers"
    />
    <select id="community-category" name="category" aria-label="Category">
      <option value="">All categories ({total.toLocaleString('en-US')})</option>
      {categories.map((c) => (
        <option value={c.category}>{c.category} ({c.count.toLocaleString('en-US')})</option>
      ))}
    </select>
  </form>

  <noscript>
    <p class="section-note">
      The directory filter needs JavaScript. Without it, browse the raw catalog on
      <a href="https://github.com/bendyline/gilde/tree/main/data/community/toolsets">GitHub</a>
      or install <code>@bendyline/gilde</code> from npm.
    </p>
  </noscript>

  <p class="result-count" id="community-count" hidden></p>
  <ul class="community-list" id="community-list"></ul>

  <script>
    // The one JS island on the site. Community strings are untrusted
    // third-party content: everything is rendered via textContent, never
    // markup, and links are only emitted for http(s) URLs.
    const input = document.getElementById('community-q') as HTMLInputElement;
    const select = document.getElementById('community-category') as HTMLSelectElement;
    const list = document.getElementById('community-list') as HTMLUListElement;
    const countEl = document.getElementById('community-count') as HTMLParagraphElement;
    const form = document.getElementById('community-filter') as HTMLFormElement;
    const PAGE = 200;

    interface Entry {
      id: string;
      name: string;
      description: string;
      license: string;
      category: string;
      url: string;
    }

    let entries: Entry[] = [];
    let shown = PAGE;

    form.addEventListener('submit', (e) => e.preventDefault());

    function matches(entry: Entry, q: string, category: string): boolean {
      if (category && entry.category !== category) return false;
      if (!q) return true;
      return (
        entry.name.toLowerCase().includes(q) ||
        entry.description.toLowerCase().includes(q) ||
        entry.id.toLowerCase().includes(q)
      );
    }

    function render() {
      const q = input.value.trim().toLowerCase();
      const category = select.value;
      const hits = entries.filter((e) => matches(e, q, category));
      list.textContent = '';
      countEl.hidden = false;
      countEl.textContent =
        hits.length === entries.length
          ? `${hits.length.toLocaleString('en-US')} servers`
          : `${hits.length.toLocaleString('en-US')} of ${entries.length.toLocaleString('en-US')} servers`;

      const frag = document.createDocumentFragment();
      for (const entry of hits.slice(0, shown)) {
        const li = document.createElement('li');
        const head = document.createElement('div');
        head.className = 'row-head';

        if (/^https?:\/\//.test(entry.url)) {
          const a = document.createElement('a');
          a.href = entry.url;
          a.rel = 'nofollow noopener';
          a.textContent = entry.name || entry.id;
          head.appendChild(a);
        } else {
          const strong = document.createElement('strong');
          strong.textContent = entry.name || entry.id;
          head.appendChild(strong);
        }

        const cat = document.createElement('span');
        cat.className = 'badge badge-plain';
        cat.textContent = entry.category;
        head.appendChild(cat);

        if (entry.license) {
          const lic = document.createElement('span');
          lic.className = 'badge badge-plain';
          lic.textContent = entry.license;
          head.appendChild(lic);
        }

        li.appendChild(head);

        if (entry.description) {
          const p = document.createElement('p');
          p.textContent = entry.description;
          li.appendChild(p);
        }
        frag.appendChild(li);
      }

      if (hits.length > shown) {
        const li = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'chip';
        button.style.cursor = 'pointer';
        button.textContent = `Show ${Math.min(PAGE, hits.length - shown).toLocaleString('en-US')} more`;
        button.addEventListener('click', () => {
          shown += PAGE;
          render();
        });
        li.appendChild(button);
        frag.appendChild(li);
      }

      list.appendChild(frag);
    }

    let timer: ReturnType<typeof setTimeout> | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        shown = PAGE;
        render();
      }, 120);
    });
    select.addEventListener('change', () => {
      shown = PAGE;
      render();
    });

    fetch('/community-search.json')
      .then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      })
      .then((data: Entry[]) => {
        entries = data;
        render();
      })
      .catch(() => {
        countEl.hidden = false;
        countEl.textContent = 'Could not load the directory index. Try reloading.';
      });
  </script>
</Layout>
