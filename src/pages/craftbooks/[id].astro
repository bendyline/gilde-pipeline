---
import Layout from '../../layouts/Layout.astro';
import { craftbooks, orderedSteps, githubTreeUrl, excerpt } from '../../lib/catalog';
import type { Craftbook } from '../../lib/catalog';

export function getStaticPaths() {
  return craftbooks().map((book) => ({ params: { id: book.id }, props: { book } }));
}

interface Props {
  book: Craftbook;
}

const { book } = Astro.props;
const steps = orderedSteps(book);
const triggers: string[] = Array.isArray(book.triggers)
  ? book.triggers.filter((t: unknown): t is string => typeof t === 'string')
  : [];
const toolsets: string[] = Array.isArray(book.toolsets)
  ? book.toolsets.map((t: unknown) => String(t))
  : [];
const releasedAt = typeof book.releasedAt === 'string' ? book.releasedAt.slice(0, 10) : '';
---

<Layout title={`${book.name} - craftbooks - gilde`} description={excerpt(book.description, 155)}>
  <p><a href="/craftbooks/">&larr; All craftbooks</a></p>
  <div class="craftbook-hero">
    {book.logoUrl && (
      <img
        class="craftbook-hero-icon"
        src={book.logoUrl}
        alt=""
        width="144"
        height="144"
        decoding="async"
      />
    )}
    <div class="craftbook-hero-copy">
      <h1>{book.name}</h1>
      <p class="card-meta">
        <span class="badge badge-plain">{book.family}</span>
        {book.hasEval && <span class="badge badge-eval">eval</span>}
        <span>v{book.version}</span>
        {releasedAt && <span>released {releasedAt}</span>}
        {book.workflow && <span>workflow: {book.workflow}</span>}
      </p>
    </div>
  </div>

  <div class="prose">
    <p>{book.description}</p>
  </div>

  <h2>Steps</h2>
  <p class="section-note">
    Entry step: <code>{book.entryStepId}</code>. Each step names the specialist role it wants;
    the full working prompt is expandable.
  </p>
  <ol class="step-list">
    {steps.map((s) => (
      <li>
        <div class="step-head">
          <strong>{s.name ?? s.id}</strong>
          {s.suggestedRole && <span class="step-role">{s.suggestedRole}</span>}
          {s.id === book.entryStepId && <span class="badge badge-plain">entry</span>}
        </div>
        {s.description && <p class="step-desc">{s.description}</p>}
        {s.prompt && (
          <details class="step-prompt">
            <summary>Show working prompt</summary>
            <pre>{s.prompt}</pre>
          </details>
        )}
      </li>
    ))}
  </ol>

  {triggers.length > 0 && (
    <>
      <h2>Triggers</h2>
      <p class="section-note">Phrases that suggest this craftbook to a crew.</p>
      <ul class="chip-row">
        {triggers.map((t) => (
          <li class="chip">{t}</li>
        ))}
      </ul>
    </>
  )}

  {toolsets.length > 0 && (
    <>
      <h2>Toolsets</h2>
      <ul class="chip-row">
        {toolsets.map((t) => (
          <li class="chip">{t}</li>
        ))}
      </ul>
    </>
  )}

  <h2>Source</h2>
  <p>
    <a href={githubTreeUrl('craftbook-templates', book.id)}>
      View this craftbook on GitHub
    </a>
    {book.license && <span> &middot; {book.license} license</span>}
  </p>
</Layout>
