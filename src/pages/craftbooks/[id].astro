---
import Redirect from '../../layouts/Redirect.astro';
import { GEZEL_DOCS, itemIds } from '../../lib/catalog';

export function getStaticPaths() {
  return itemIds('craftbook-templates').map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
---

<Redirect to={`${GEZEL_DOCS}craftbook/${id}/`} />
