---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'gilde: the open catalog of craftbooks, models, roles, and toolsets that powers gezel.' } = Astro.props;
const nav = [
  ['/craftbooks/', 'Craftbooks'],
  ['/models/', 'Models'],
  ['/roles/', 'Roles'],
  ['/toolsets/', 'Toolsets'],
  ['/community/', 'Community'],
  ['/docs/update-manifest/', 'Docs'],
] as const;
const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="icon"
      href={'data:image/svg+xml,' +
        encodeURIComponent(
          '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3" fill="%23f8f4ec" stroke="%238a5a2b" stroke-width="2"/><path d="M15.5 9.5a4 4 0 1 0 .5 4h-3" fill="none" stroke="%238a5a2b" stroke-width="2" stroke-linecap="round"/></svg>'
        )}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="3.5" fill="none" class="mark-stroke" stroke-width="1.8"></rect>
            <path d="M15.5 9.5a4 4 0 1 0 .5 4h-3.2" fill="none" class="mark-stroke" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <span>gilde</span>
        </a>
        <nav class="site-nav" aria-label="Site">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href.split('/').slice(0, 2).join('/') + '/') ? 'true' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <span>gilde is the open catalog behind <a href="https://github.com/bendyline">gezel</a>. Dutch for guild.</span>
        <span>
          <a href="https://github.com/bendyline/gilde">GitHub</a>
          &nbsp;&middot;&nbsp;
          <a href="https://www.npmjs.com/package/@bendyline/gilde">npm</a>
        </span>
      </div>
    </footer>
  </body>
</html>
